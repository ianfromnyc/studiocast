  "output": {
    "name": "output",
    "kind": "alpha",
    "dtype": "float32"
  },
  "preprocess": {
    "mean": [0.5, 0.5, 0.5],
    "std": [0.5, 0.5, 0.5],
    "color": "rgb",
    "range": "0..1"
  }
